<Project Sdk="Microsoft.NET.Sdk">

  <!--
    btctl：经典蓝牙 (SPP) 扫描/配对伴生工具
    由 Godot 应用通过子进程调用（模式同 stcflash / ik_sim_serial_bridge）。

    为什么用 net8.0-windows10.0.19041.0：
      - 该 TFM 自动引入 CsWinRT 投影，可直接 using Windows.Devices.*
      - 后续配对功能需要 Windows.Devices.Enumeration.DevicePairing（WinRT），
        本 TFM 一次性配齐，不必再 P/Invoke bluetoothapis.dll。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>BtCtl</RootNamespace>
    <AssemblyName>btctl</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
