#!/usr/bin/env python
"""构建 pieblock_hid GDExtension（Windows 裸 HID）。

用法（工作区根）：
  PATH=/c/msys64/ucrt64/bin:$PATH .venv/Scripts/python.exe -m SCons -C tools/gdext_pieblock_hid \\
      platform=windows target=template_release use_mingw=yes -j8

产物：tools/gdext_pieblock_hid/bin/pieblock_hid.windows.template_release.x86_64.dll
（build_gdext_pieblock_hid.bat 负责拷贝到 addons/pieblock_usb/win/pieblock_hid.dll）
"""
import os

env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])

# 静态链接 MinGW 运行库，避免目标机器缺 libstdc++-6.dll / libgcc_s_seh-1.dll
env.Append(LINKFLAGS=["-static-libgcc", "-static-libstdc++"])

# Win32 裸 HID：setupapi（枚举设备接口）+ hid（HidD_*）。均为系统自带 DLL。
env.Append(LIBS=["hid", "setupapi"])

sources = Glob("src/*.cpp")

library = env.SharedLibrary(
    "bin/pieblock_hid{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)

Default(library)
