{
  "version": "sdcc_runtime_v3_hspwm_prescaler",
  "kind_projects": {
    "infantry": "ROBOMASTER_INFANTRY",
    "engineer": "ROBOMASTER_ENGINEER",
    "debug": "TEST",
    "music": "BUZZER_MUSIC_GENERATED"
  },
  "include_dirs": [
    "include",
    "startup",
    "libraries/drivers/inc",
    "libraries/boards/inc"
  ],
  "runtime_libraries": [
    "mcs251.lib",
    "libsdcc.lib",
    "liblong.lib",
    "libint.lib",
    "libfloat.lib",
    "liblonglong.lib"
  ],
  "compile_flags": [
    "-mmcs251",
    "--model-large",
    "--stack-auto",
    "--opt-code-size",
    "--constseg",
    "CSEG",
    "-c"
  ],
  "link_flags": [
    "-mmcs251",
    "--model-large",
    "--stack-auto",
    "--constseg",
    "CSEG",
    "--nostdlib",
    "--iram-size",
