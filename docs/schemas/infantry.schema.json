{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "步兵机器人：底盘4电机+云台(Yaw/Pitch)+摩擦轮+拨弹。P64/P66固定用于摩擦轮。",
  "kind": "infantry",
  "properties": {
    "arrow_key": {
      "default": "移动",
      "enum": [
        "移动",
        "冲刺",
        "其他"
      ],
      "type": "string"
    },
    "booster_dir": {
      "default": "正向",
      "enum": [
        "正向",
        "反向"
      ],
      "type": "string"
    },
    "booster_io": {
      "default": "P60",
      "description": "拨弹电机 IO（单引脚，扩展板；P64/P66 不可选）",
      "type": "string"
    },
    "booster_key": {
      "description": "摩擦轮开关键",
      "type": "string"
    },
    "channel": {
      "default": "36",
      "description": "NRF24L01 通道号 (0-125)",
      "type": "string"
    },
    "deadzone": {
      "default": "10",
      "description": "摇杆死区 (0-2047)",
      "type": "string"
    },
    "pwm_group_init": {
      "description": "PWM 组初始化频率；步兵 PWMA 固定为 50Hz、PWMB 固定为 10000Hz",
      "properties": {
        "PWMA": {
          "const": "50Hz",
          "default": "50Hz",
          "type": "string"
        },
        "PWMB": {
          "const": "10000Hz",
          "default": "10000Hz",
          "type": "string"
        }
      },
      "type": "object"
    },
    "io_role": {
      "additionalProperties": {
        "enum": ["舵机", "摩擦轮", "抖动电机", "平滑电机"],
        "type": "string"
      },
      "description": "各引脚输出角色，与 PWM 组频率独立",
      "type": "object"
    },
    "feed_mode": {
      "default": "阻塞开环",
      "description": "拨弹模式：目视闭环=按住持续拨弹松开即停（不阻塞）；阻塞开环=按一下拨弹固定时长（阻塞主循环）",
      "enum": [
        "目视闭环",
        "阻塞开环"
      ],
      "type": "string"
    },
    "l1_dir": {
      "default": "正向",
      "enum": [
        "正向",
        "反向"
      ],
      "type": "string"
    },
    "l1_io": {
      "default": "P74 P24",
      "description": "左前轮 IO（扩展板通信脚+方向脚，如 'P74 P24'；P64/P66 不可选）",
      "type": "string"
    },
    "l2_dir": {
      "default": "正向",
      "enum": [
        "正向",
        "反向"
      ],
      "type": "string"
    },
    "l2_io": {
      "default": "P75 P25",
      "description": "左后轮 IO（P64/P66 不可选）",
      "type": "string"
    },
    "normal_speed": {
      "default": "4000",
      "description": "普通速度 (0-10000)",
      "type": "string"
    },
    "pitch_dir": {
      "default": "正向",
      "enum": [
        "正向",
        "反向"
      ],
      "type": "string"
    },
    "pitch_drive": {
      "default": "舵机",
      "enum": [
        "舵机",
        "电机"
      ],
      "type": "string"
    },
    "pitch_io": {
      "description": "Pitch 轴 IO",
      "type": "string"
    },
    "pitch_mid_offset": {
      "default": "0",
      "description": "Pitch 归中角偏移 (-90~90)",
      "type": "string"
    },
    "r1_dir": {
      "default": "正向",
      "enum": [
        "正向",
        "反向"
      ],
      "type": "string"
    },
    "r1_io": {
      "default": "P76 P26",
      "description": "右前轮 IO（P64/P66 不可选）",
      "type": "string"
    },
    "r2_dir": {
      "default": "正向",
      "enum": [
        "正向",
        "反向"
      ],
      "type": "string"
    },
    "r2_io": {
      "default": "P77 P27",
      "description": "右后轮 IO（P64/P66 不可选）",
      "type": "string"
    },
    "sprint_enabled": {
      "default": false,
      "description": "按下左摇杆冲刺",
      "type": "boolean"
    },
    "sprint_speed": {
      "default": "8000",
      "description": "冲刺速度 (0-10000)",
      "type": "string"
    },
    "trigger_key": {
      "description": "扳机键（拨弹触发键）",
      "type": "string"
    },
    "trigger_speed": {
      "description": "拨弹速度 (0-10000)",
      "type": "string"
    },
    "trigger_time": {
      "description": "拨弹时间 ms (0-65535)",
      "type": "string"
    },
    "yaw_dir": {
      "default": "正向",
      "enum": [
        "正向",
        "反向"
      ],
      "type": "string"
    },
    "yaw_drive": {
      "default": "舵机",
      "enum": [
        "舵机",
        "电机"
      ],
      "type": "string"
    },
    "yaw_io": {
      "description": "Yaw 轴 IO",
      "type": "string"
    },
    "yaw_mid_offset": {
      "default": "0",
      "description": "Yaw 归中角偏移 (-90~90)",
      "type": "string"
    },
    "zero_enabled": {
      "default": false,
      "description": "松手归中",
      "type": "boolean"
    }
  },
  "title": "Pie-Block 步兵 配置",
  "type": "object"
}
