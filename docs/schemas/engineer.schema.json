{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "工程机器人：底盘4电机、1～4个独立操作模式、两种切换策略和任意IO按键映射。支持舵机/电机混用。",
  "kind": "engineer",
  "properties": {
    "channel": {
      "default": "36",
      "description": "NRF24L01 通道号 (0-125)",
      "type": "string"
    },
    "deadzone": {
      "default": "10",
      "description": "摇杆死区 (0-2047)",
      "type": "string"
    },
    "pwm_group_init": {
      "description": "PWMA/PWMB 组初始化频率；同组四路必须同频",
      "properties": {
        "PWMA": {
          "default": "50Hz",
          "enum": ["50Hz", "10000Hz"],
          "type": "string"
        },
        "PWMB": {
          "default": "10000Hz",
          "enum": ["50Hz", "10000Hz"],
          "type": "string"
        }
      },
      "type": "object"
    },
    "io_role": {
      "additionalProperties": {
        "enum": ["舵机", "摩擦轮", "抖动电机", "平滑电机"],
        "type": "string"
      },
      "description": "各引脚输出角色，与 PWM 组频率独立",
      "type": "object"
    },
    "io_mid": {
      "description": "各引脚舵机初始角（相对中位偏移角，-90~90，仅舵机有效）",
      "properties": {
        "P60": {
          "default": "",
          "type": "string"
        },
        "P62": {
          "default": "",
          "type": "string"
        },
        "P64": {
          "default": "",
          "type": "string"
        },
        "P66": {
          "default": "",
          "type": "string"
        },
        "P74": {
          "default": "",
          "type": "string"
        },
        "P75": {
          "default": "",
          "type": "string"
        },
        "P76": {
          "default": "",
          "type": "string"
        },
        "P77": {
          "default": "",
          "type": "string"
        },
        "MP03": {
          "default": "",
          "type": "string"
        },
        "MP74": {
          "default": "",
          "type": "string"
        }
      },
      "type": "object"
    },
    "l1_dir": {
      "default": "正向",
      "enum": [
        "正向",
        "反向"
      ],
      "type": "string"
    },
    "l1_io": {
      "default": "P74 P24",
      "type": "string"
    },
    "l2_dir": {
      "default": "正向",
      "enum": [
        "正向",
        "反向"
      ],
      "type": "string"
    },
    "l2_io": {
      "default": "P75 P25",
      "type": "string"
    },
    "normal_speed": {
      "default": "4000",
      "description": "普通速度 (0-10000)",
      "type": "string"
    },
    "r1_dir": {
      "default": "正向",
      "enum": [
        "正向",
        "反向"
      ],
      "type": "string"
    },
    "r1_io": {
      "default": "P76 P26",
      "type": "string"
    },
    "r2_dir": {
      "default": "正向",
      "enum": [
        "正向",
        "反向"
      ],
      "type": "string"
    },
    "r2_io": {
      "default": "P77 P27",
      "type": "string"
    },
    "sprint_enabled": {
      "default": false,
      "description": "按下左摇杆冲刺",
      "type": "boolean"
    },
    "sprint_speed": {
      "default": "8000",
      "description": "冲刺速度 (0-10000)",
      "type": "string"
    },
    "mode_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "description": "操作模式个数（1~4）"
    },
    "switch_strategy": {
      "type": "string",
      "enum": [
        "单击切换",
        "一一对应"
      ],
      "default": "单击切换",
      "description": "模式切换方式：单击切换=一个键轮换；一一对应=每模式一个键"
    },
    "mode_switch_key": {
      "type": "string",
      "default": "E",
      "description": "单击切换时的模式切换键"
    },
    "mode_keys": {
      "type": "array",
      "description": "一一对应时各模式的切换键（模式1~4）",
      "maxItems": 4,
      "items": {
        "type": "string"
      }
    },
    "modes": {
      "type": "array",
      "description": "每模式一组动态按键映射行（最多 4 个模式）",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "E/↑/↓/←/→/A/B/C/D/LC/RC（按键）或 LX/LY/RX/RY（摇杆轴）"
                },
                "dir": {
                  "type": "string",
                  "enum": [
                    "正",
                    "反"
                  ],
                  "default": "正"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "增量",
                    "直接",
                    "速度",
                    "增速"
                  ],
                  "description": "增量/直接（舵机），直接/速度/增速（电机）；摇杆行只能用 增量/速度/增速"
                },
                "param": {
                  "type": "string",
                  "description": "步长(°) / 角度(°) / 速度(0-10000)"
                },
                "io": {
                  "type": "string",
                  "description": "目标 IO（P60~P77/MP03/MP74）"
                }
              }
            }
          }
        }
      }
    }
  },
  "title": "Pie-Block 工程 配置",
  "type": "object"
}
