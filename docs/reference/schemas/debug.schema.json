{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Flutter 调试项目配置：按 tests 数组顺序逐项测试固定引脚。摩擦轮测试项直接填目标占空比（500–800），低于 600 给提醒，不再走「油门 → 满油上限」换算。",
  "properties": {
    "tests": {
      "description": "固定十路引脚的可排序测试序列",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "properties": {
          "direction": {
            "enum": [
              "forward",
              "reverse",
              null
            ],
            "type": ["string", "null"]
          },
          "drive_type": {
            "enum": [
              "motor",
              "servo",
              "friction",
              null
            ],
            "type": ["string", "null"]
          },
          "enabled": {
            "description": "是否启用该行",
            "type": "boolean"
          },
          "pin": {
            "enum": [
              "P60",
              "P62",
              "P64",
              "P66",
              "P74",
              "P75",
              "P76",
              "P77",
              "MP03",
              "MP74"
            ],
            "type": "string"
          },
          "value": {
            "description": "电机速度、舵机角度，或摩擦轮的目标占空比（500–800，低于 600 给提醒）",
            "maximum": 10000,
            "minimum": 0,
            "type": ["integer", "null"]
          },
          "duration_ms": {
            "description": "电机/舵机测试时长；摩擦轮不保存",
            "minimum": 1000,
            "maximum": 30000,
            "type": "integer"
          }
        },
        "required": ["pin", "enabled", "drive_type", "direction", "value"],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": ["tests"],
  "title": "Pie-Block 调试 配置",
  "type": "object"
}
