{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PIE-Block Flutter 音乐配置",
  "description": "钢琴卷帘及 MIDI 往返数据。允许音符重叠：按 overlap_mode 与 new_note_interrupts 单音裁决，只有裁决胜出的音符/片段发声。",
  "kind": "music",
  "type": "object",
  "properties": {
    "ticks_per_quarter": {"type": "integer", "minimum": 1, "maximum": 32767},
    "source_name": {"type": ["string", "null"]},
    "track_name": {"type": ["string", "null"]},
    "notes": {
      "type": "array",
      "maxItems": 32768,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "pitch": {"type": "integer", "minimum": 1, "maximum": 127},
          "start_tick": {"type": "integer", "minimum": 0},
          "duration_ticks": {"type": "integer", "minimum": 1}
        },
        "required": ["id", "pitch", "start_tick", "duration_ticks"],
        "additionalProperties": false
      }
    },
    "overlap_mode": {
      "description": "重叠时的单音裁决策略：取高音 / 取低音 / 取最近音阶（最接近上一个有效发声音高，曲首取最高音）",
      "enum": ["highest", "lowest", "nearest"]
    },
    "new_note_interrupts": {
      "description": "勾选后，后起始的音符会打断仍在发声的音符（被打断的尾巴不发声）",
      "type": "boolean"
    },
    "tempo_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "tick": {"type": "integer", "minimum": 0},
          "microseconds_per_quarter": {"type": "integer", "minimum": 1, "maximum": 16777215}
        },
        "required": ["tick", "microseconds_per_quarter"],
        "additionalProperties": false
      }
    },
    "time_signature_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "tick": {"type": "integer", "minimum": 0},
          "numerator": {"type": "integer", "minimum": 1},
          "denominator": {"enum": [1, 2, 4, 8, 16, 32, 64]}
        },
        "required": ["tick", "numerator", "denominator"],
        "additionalProperties": false
      }
    }
  },
  "required": ["ticks_per_quarter", "notes", "overlap_mode", "new_note_interrupts", "tempo_events", "time_signature_events"],
  "additionalProperties": false
}
