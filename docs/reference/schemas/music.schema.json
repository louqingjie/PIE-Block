{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PIE-Block Flutter 音乐配置",
  "description": "单音主旋律钢琴卷帘及 MIDI 往返数据。相同 start_tick 必须且只能有一个 primary 音符。",
  "kind": "music",
  "type": "object",
  "properties": {
    "ticks_per_quarter": {"type": "integer", "minimum": 1, "maximum": 32767},
    "source_name": {"type": ["string", "null"]},
    "track_name": {"type": ["string", "null"]},
    "notes": {
      "type": "array",
      "maxItems": 32768,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "pitch": {"type": "integer", "minimum": 1, "maximum": 127},
          "start_tick": {"type": "integer", "minimum": 0},
          "duration_ticks": {"type": "integer", "minimum": 1},
          "primary": {"type": "boolean"}
        },
        "required": ["id", "pitch", "start_tick", "duration_ticks", "primary"],
        "additionalProperties": false
      }
    },
    "tempo_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "tick": {"type": "integer", "minimum": 0},
          "microseconds_per_quarter": {"type": "integer", "minimum": 1, "maximum": 16777215}
        },
        "required": ["tick", "microseconds_per_quarter"],
        "additionalProperties": false
      }
    },
    "time_signature_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "tick": {"type": "integer", "minimum": 0},
          "numerator": {"type": "integer", "minimum": 1},
          "denominator": {"enum": [1, 2, 4, 8, 16, 32, 64]}
        },
        "required": ["tick", "numerator", "denominator"],
        "additionalProperties": false
      }
    }
  },
  "required": ["ticks_per_quarter", "notes", "tempo_events", "time_signature_events"],
  "additionalProperties": false
}
