# Godot 4+ specific ignores
.godot/
.godot-test-data/
/android/

.vscode/

# Keil MDK build output
# 忽略目录内的编译产物，但保留 .gdignore 本身可被 git 跟踪
# （注意不能用 `**/Objects/` 目录级忽略，否则 git 不会进入目录，
#  里面的 .gdignore 也一起被忽略、无法提交）
**/Objects/**
!**/Objects/.gdignore
**/Listings/**
!**/Listings/.gdignore

# Keil user and workspace state
*.uvopt
*.uvoptx
*.uvgui.*

# Keil and embedded build artifacts
*.axf
*.bin
*.hex
*.map
*.lst
*.obj
*.o
*.crf
*.__i
*.lnp
*.build_log.htm
**/pie_block_build.log
**/build_test.log
stc32g/Projects/**/MDK/*.log

# Temporary and backup files
*.bak
*.tmp
*~
~*
# 调试/探针脚本与临时产物（约定以 _tmp_ 前缀命名）
_tmp_*

# 调试/测试输出文件（终端重定向产物，不提交）
*_out.txt
test_out_*.txt
hex_layout_sim.txt
ports_check.txt
ports_detailed.txt
probe_*.txt

# Dependencies
node_modules/

dist/
release/

# Bundled Keil toolchain (licensed binaries; prepare via script, do not commit)
vendor/keil-toolchain/
toolchain/

# btctl (.NET 构建产物；源码 tools/btctl/*.cs / *.csproj 提交，产物不提交)
tools/btctl/bin/
tools/btctl/obj/
tools/btctl/out/

# Re-include STC serial flash helpers under stc32g/toolchain (Keil tree still ignored)
!stc32g/toolchain/
stc32g/toolchain/**
!stc32g/toolchain/stcflash/
!stc32g/toolchain/stcflash/**
!stc32g/toolchain/mcs251-sim/
!stc32g/toolchain/mcs251-sim/**
!stc32g/toolchain/mcs251-tests/
!stc32g/toolchain/mcs251-tests/**
stc32g/toolchain/stcflash/__pycache__/
stc32g/toolchain/mcs251-sim/__pycache__/
stc32g/toolchain/mcs251-tests/__pycache__/
stc32g/toolchain/mcs251-tests/build/

*.pieproj

# Local ISP/flash debug scratch (do not commit)
STC32G.pdf
_probe_*
_rxdebug*

# ---------------------------------------------------------------------------
# bootloader hex 例外（必须放在文件末尾，否则会被上面的
# `**/Objects/` 与 `dist/` 规则盖掉；gitignore 后出现的规则优先）
#
# 它不是普通编译产物，而是分发套件的一部分：每块板子出厂前要用
# 官方 STC-ISP 手工烧这一次（工作频率 33.1776MHz、EEPROM 设 128K、
# 烧完重新上电），之后 App 才能走串口 OTA 升级。
#
# 注意目录级忽略的坑：`**/Objects/` 是目录规则，文件级 `!` 例外
# 穿不过去，所以 hex 得拷到 dist/ 而不能直接保留 MDK/Objects/ 里的。
!stc32g/Projects/PIE_BOOTLOADER/dist/
!stc32g/Projects/PIE_BOOTLOADER/dist/*.hex
extract_*.py
flash_test*.log
flash_try*
stcgal_*.txt
stcgal_*.out
stcgal_*.err
test_isp_*.py
test_fast_isp.py
test_combined.py

# Python
__pycache__/
*.pyc
.venv/

test_debug_rx.py
test_trigger*.py
test_uart_isp_diag.py
trigger_test.py
raw_listen.py
dep2.txt
dep2err.txt
gen2.txt
gen2err.txt
p_err.txt
p_out.txt

# 联调/构建终端输出
build_apk.txt
sdk_install.txt
sdk_output.txt
inspect_out.txt
test_static_out.txt

# 手机调试截图（临时产物）
phone_screen*.png
phone_screen*.png.import

# Android app 构建产物与本地配置
android_app/.gradle/
android_app/build/
android_app/app/build/
android_app/local.properties
android_app/.idea/
android_app/.kotlin/
android_app/captures/
android_app/.externalNativeBuild/
android_app/.cxx/
android_app/*.iml

# Godot Android 构建模板（由导出流程生成/安装）与烧录插件构建产物
android/build/
android/plugins/pieblock_usb/.gradle/
android/plugins/pieblock_usb/plugin/build/
android/plugins/pieblock_usb/build/
android/plugins/pieblock_usb/local.properties
addons/pieblock_usb/bin/

# Windows 裸 HID GDExtension：godot-cpp 克隆与构建产物不入库（构建脚本会自动克隆）
tools/gdext_pieblock_hid/godot-cpp/
tools/gdext_pieblock_hid/bin/
tools/gdext_pieblock_hid/.sconsign.dblite

# .NET / Godot Mono 构建产物（原生终端与 C# 工程）
**/obj/
tools/terminal_poc/bin/
