.vscode/

# Keil MDK build output
**/Objects/
**/Listings/

# Keil user and workspace state
*.uvopt
*.uvoptx
*.uvgui.*

# Keil and embedded build artifacts
*.axf
*.bin
*.hex
*.map
*.lst
*.obj
*.o
*.crf
*.__i
*.lnp
*.build_log.htm
**/pie_block_build.log
**/build_test.log
*.log

# Temporary and backup files
*.bak
*.tmp
*~

# Dependencies
node_modules/

dist/
release/

# Bundled Keil toolchain is tracked under vendor/keil-toolchain/
# (licensed binaries; only commit if you have redistribution rights).
# Keep prepare script for refresh: npm run prepare:keil
#
# Un-ignore any global artifact rules that might hit the bundle:
!vendor/keil-toolchain/**
!vendor/keil-toolchain/**/*.bin
!vendor/keil-toolchain/**/*.hex
!vendor/keil-toolchain/**/*.map
!vendor/keil-toolchain/**/*.lst
!vendor/keil-toolchain/**/*.obj
!vendor/keil-toolchain/**/*.o
!vendor/keil-toolchain/**/*.log