# Godot 4+ specific ignores
.godot/
/android/

.vscode/

# Keil MDK build output
**/Objects/
**/Listings/

# Keil user and workspace state
*.uvopt
*.uvoptx
*.uvgui.*

# Keil and embedded build artifacts
*.axf
*.bin
*.hex
*.map
*.lst
*.obj
*.o
*.crf
*.__i
*.lnp
*.build_log.htm
**/pie_block_build.log
**/build_test.log
stc32g/Projects/**/MDK/*.log

# Temporary and backup files
*.bak
*.tmp
*~
# 调试/探针脚本与临时产物（约定以 _tmp_ 前缀命名）
_tmp_*

# Dependencies
node_modules/

dist/
release/

# Bundled Keil toolchain (licensed binaries; prepare via script, do not commit)
vendor/keil-toolchain/
toolchain/

# Re-include STC serial flash helpers under stc32g/toolchain (Keil tree still ignored)
!stc32g/toolchain/
stc32g/toolchain/**
!stc32g/toolchain/stcflash/
!stc32g/toolchain/stcflash/**
stc32g/toolchain/stcflash/__pycache__/

*.pieproj

