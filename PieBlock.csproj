<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PieBlock</RootNamespace>
    <AssemblyName>PieBlock</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Godot 源生成器负责 AssemblyInfo，禁用 SDK 自动生成避免重复属性 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <!-- 终端模拟核心（xterm.js 的 C# 移植，MIT，公开源码） -->
    <PackageReference Include="XTerm.NET" Version="1.0.15" />
    <!-- ConPTY 伪终端（MIT，公开源码，Windows 用系统 ConPTY API） -->
    <PackageReference Include="Porta.Pty" Version="1.0.7" />
  </ItemGroup>
</Project>